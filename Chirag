    else if(scene==='aurora'){const g=x.createLinearGradient(0,0,0,H);g.addColorStop(0,'#000814');g.addColorStop(1,'#001020');x.fillStyle=g;x.fillRect(0,0,W,H);for(let i=0;i<65;i++){x.fillStyle=`rgba(255,255,255,${.2+.3*Math.sin(t*2+i)})`;x.fillRect((i*89)%W,(i*61)%(H*.45),1.2,1.2);}for(let a=0;a<5;a++){x.beginPath();for(let px=0;px<=W;px+=4){const py=H*.25+Math.sin((px/W*3+t*.5+a*.8)*Math.PI)*H*.2+a*H*.06;px===0?x.moveTo(px,py):x.lineTo(px,py);}x.lineWidth=22;x.strokeStyle=`hsla(${140+a*25},80%,55%,.08)`;x.stroke();x.lineWidth=4;x.strokeStyle=`hsla(${140+a*25},80%,70%,.13)`;x.stroke();}}
