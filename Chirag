// ═══ AUTO-INJECT CODE ENGINE ═══
function injectCode(){
  const name=(document.getElementById('injN').value||'').trim();
  const code=(document.getElementById('injC').value||'').trim();
  const log=document.getElementById('injLog');
  if(!name||!code){toast('⚠️ Name + code required');return;}
  log.style.color='var(--a)';log.textContent='⏳ Auto-attaching to live app...';
  let ok=0,errs=[],injected=[];

  // 1. Extract & inject CSS
  const cssBlocks=code.match(/<style[^>]*>([\s\S]*?)<\/style>/gi)||[];
  cssBlocks.forEach(block=>{
    try{const el=document.createElement('style');el.setAttribute('data-feat',name);el.textContent=block.replace(/<\/?style[^>]*>/gi,'');document.head.appendChild(el);ok++;injected.push('CSS');}catch(e){errs.push('CSS:'+e.message);}
  });
  // Also inject bare CSS (no style tags, if it looks like CSS)
  const bareCode=code.replace(/<style[\s\S]*?<\/style>/gi,'').replace(/<script[\s\S]*?<\/script>/gi,'').replace(/<[^>]+>/g,'').trim();
  if(bareCode&&/[{:;]/.test(bareCode)&&!/</.test(bareCode)&&cssBlocks.length===0){
    try{const el=document.createElement('style');el.setAttribute('data-feat',name);el.textContent=bareCode;document.head.appendChild(el);ok++;injected.push('CSS');}catch(e){}
  }

  // 2. Extract & inject JS
  const jsBlocks=code.match(/<script[^>]*>([\s\S]*?)<\/script>/gi)||[];
  jsBlocks.forEach(block=>{
    try{const el=document.createElement('script');el.setAttribute('data-feat',name);el.textContent=block.replace(/<\/?script[^>]*>/gi,'');document.body.appendChild(el);ok++;injected.push('JS');}catch(e){errs.push('JS:'+e.message);}
  });

  // 3. Extract & inject HTML (strip style/script already handled)
  const htmlOnly=code.replace(/<style[\s\S]*?<\/style>/gi,'').replace(/<script[\s\S]*?<\/script>/gi,'').trim();
  if(htmlOnly&&/<[a-zA-Z]/.test(htmlOnly)){
    try{
      const wrap=document.createElement('div');wrap.className='inj-widget';wrap.setAttribute('data-feat',name);
      wrap.innerHTML=htmlOnly;
      const xb=document.createElement('button');xb.className='inj-close';xb.textContent='✕';xb.title='Close '+name;xb.onclick=()=>wrap.remove();
      wrap.insertBefore(xb,wrap.firstChild);document.body.appendChild(wrap);ok++;injected.push('HTML widget');
    }catch(e){errs.push('HTML:'+e.message);}
  }

  // 4. Pure JS (no HTML/CSS tags at all) — improved detection
  const noHtmlCode=code.replace(/<style[\s\S]*?<\/style>/gi,'').replace(/<script[\s\S]*?<\/script>/gi,'').replace(/<[a-zA-Z][^>]*>[\s\S]*?<\/[a-zA-Z]+>/gi,'').trim();
  const looksLikeJS=!/<[a-zA-Z]/.test(noHtmlCode)&&(noHtmlCode.includes('function ')||noHtmlCode.includes('=>')||noHtmlCode.includes('const ')||noHtmlCode.includes('let ')||noHtmlCode.includes('var ')||noHtmlCode.includes('document.')||noHtmlCode.includes('window.')||noHtmlCode.includes('alert(')||noHtmlCode.includes('console.'));
  if(noHtmlCode&&looksLikeJS&&jsBlocks.length===0){
    try{const fn=new Function(noHtmlCode);fn();ok++;injected.push('JS exec');}catch(e){errs.push('JSexec:'+e.message);}
  }

  // Add to features list
  features.push({id:'inj_'+Date.now(),n:name,d:'Auto-injected: '+injected.join(', '),on:true,sys:false,injected:true,code:code.slice(0,100)+'...'});
  // Add to history
  injHistory.unshift({name,time:new Date().toLocaleTimeString(),types:injected,ok,code:code.slice(0,80)});
  updateAdmStats();renderFeatList();renderInjHistory();
  document.getElementById('injN').value='';document.getElementById('injC').value='';
  if(!errs.length){log.style.color='var(--a3)';log.textContent='✅ "'+name+'" auto-attached! Injected: '+injected.join(' + ')+' ('+ok+' blocks)';}
  else{log.style.color='var(--a4)';log.textContent='⚠️ '+ok+' ok. Errors: '+errs.join(' | ');}
  toast('⚡ '+name+' attached to live app!');
}
