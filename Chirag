<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>NEURO AI v10 — ULTRA SECURE</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#050814;--s1:#070b18;--s2:#0d1326;--s3:#0f1528;--a:#00eaff;--a2:#ff00ff;--a3:#00ff88;--a4:#ff8800;--a6:#ff0044;--gold:#ffd700;--bdr:rgba(0,234,255,.15);--txt:#fff;--t2:#8899bb;--t3:#2a3a55}
*{margin:0;padding:0;box-sizing:border-box}html,body{height:100%;overflow:hidden}
body{background:var(--bg);color:var(--txt);font-family:Inter,sans-serif;font-size:13px}
::-webkit-scrollbar{width:3px}::-webkit-scrollbar-thumb{background:rgba(0,234,255,.3);border-radius:2px}

/* ── BIO SCREEN ── */
#bio{position:fixed;inset:0;z-index:9999;background:radial-gradient(ellipse at center,#000c20,#000 75%);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0}
#bio.gone{animation:bgone .8s ease forwards;pointer-events:none}
@keyframes bgone{to{opacity:0;transform:scale(1.04)}}
.bt{font-family:Orbitron,monospace;font-size:40px;font-weight:900;letter-spacing:8px;background:linear-gradient(90deg,#00eaff,#ff00ff,#00ff88,#ff8800,#00eaff);background-size:400%;-webkit-background-clip:text;-webkit-text-fill-color:transparent;animation:gf 4s linear infinite;text-align:center;margin-bottom:4px}
@keyframes gf{to{background-position:400%}}
.bs{font-size:8px;color:rgba(0,234,255,.35);letter-spacing:5px;text-align:center;margin-bottom:44px}
.beye{position:relative;width:190px;height:190px;cursor:pointer;margin-bottom:20px;user-select:none}
.br{position:absolute;inset:0;border-radius:50%;animation:spin 4s linear infinite}
.br::before{content:'';position:absolute;inset:0;border-radius:50%;border:2px solid transparent;background:conic-gradient(#00eaff,#ff00ff,#00ff88,#00eaff) border-box;-webkit-mask:linear-gradient(#fff 0 0)padding-box,linear-gradient(#fff 0 0);-webkit-mask-composite:destination-out;mask-composite:exclude}
.br2{position:absolute;inset:12px;border-radius:50%;border:1px solid rgba(0,234,255,.2);animation:spin 8s linear infinite reverse}
@keyframes spin{to{transform:rotate(360deg)}}
.iris{position:absolute;inset:26px;border-radius:50%;background:radial-gradient(circle,#000e1a,#001830 55%,#000811);border:2px solid rgba(0,234,255,.5);display:flex;align-items:center;justify-content:center;box-shadow:0 0 40px rgba(0,234,255,.2),inset 0 0 25px rgba(0,234,255,.05);overflow:hidden;transition:all .3s}
.iris.ok{border-color:rgba(0,255,136,1);box-shadow:0 0 80px rgba(0,255,136,.7)}
.sh{position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,rgba(0,234,255,.9),transparent);animation:scanH 2s ease-in-out infinite}
@keyframes scanH{0%,100%{top:0;opacity:0}10%{opacity:1}90%{top:100%;opacity:1}}
.bs2{font-size:11px;color:var(--a);letter-spacing:2px;text-align:center;margin-bottom:4px;min-height:18px}
.bsb{font-size:8px;color:rgba(0,234,255,.3);letter-spacing:1.5px;text-align:center;margin-bottom:14px;min-height:14px}
.bbar{width:240px;height:2px;background:rgba(255,255,255,.05);border-radius:1px;overflow:hidden}
.bbarf{height:100%;width:0%;background:linear-gradient(90deg,var(--a),var(--a2),var(--a3));transition:width .05s linear;border-radius:1px}
#bmicbox{display:none;margin-top:20px;padding:14px 22px;background:rgba(0,255,136,.06);border:1px solid rgba(0,255,136,.25);border-radius:12px;text-align:center;max-width:310px}
#bmicbox .bmt{font-size:11px;color:var(--a3);font-weight:700;letter-spacing:2px;margin-bottom:5px}
#bmicbox .bmd{font-size:8px;color:rgba(255,255,255,.35);line-height:2;margin-bottom:11px}
.bma{padding:9px 18px;background:linear-gradient(135deg,#00ff88,#00aa55);border:none;border-radius:8px;color:#000;font-family:Orbitron,monospace;font-size:9px;font-weight:700;cursor:pointer;margin-right:5px}
.bsk{padding:9px 12px;background:none;border:1px solid rgba(255,255,255,.1);border-radius:8px;color:rgba(255,255,255,.3);font-size:8px;cursor:pointer}

/* ── ADMIN EYE LOCK ── */
#adminEyeLock{position:fixed;inset:0;z-index:9800;background:radial-gradient(ellipse at center,#020008,#000 80%);display:none;flex-direction:column;align-items:center;justify-content:center}
#adminEyeLock.open{display:flex}
.aet{font-family:Orbitron,monospace;font-size:18px;font-weight:900;letter-spacing:4px;background:linear-gradient(90deg,#ff00ff,#7700ff,#ff00ff);background-size:300%;-webkit-background-clip:text;-webkit-text-fill-color:transparent;animation:gf 3s linear infinite;margin-bottom:4px;text-align:center}
.aes{font-size:7px;color:rgba(255,0,255,.3);letter-spacing:5px;margin-bottom:32px;text-align:center}
.aeye{position:relative;width:210px;height:210px;cursor:pointer;margin-bottom:20px;user-select:none}
.aer{position:absolute;inset:0;border-radius:50%;animation:spin 2.5s linear infinite}
.aer::before{content:'';position:absolute;inset:0;border-radius:50%;border:3px solid transparent;background:conic-gradient(#ff00ff,#7700ff,#00ffff,#ff00ff) border-box;-webkit-mask:linear-gradient(#fff 0 0)padding-box,linear-gradient(#fff 0 0);-webkit-mask-composite:destination-out;mask-composite:exclude}
.aer2{position:absolute;inset:10px;border-radius:50%;border:1px solid rgba(255,0,255,.25);animation:spin 5s linear infinite reverse}
.aer3{position:absolute;inset:20px;border-radius:50%;border:1px dashed rgba(119,0,255,.3);animation:spin 8s linear infinite}
.airis{position:absolute;inset:30px;border-radius:50%;background:radial-gradient(circle,#0a0010,#100020 55%,#050010);border:3px solid rgba(255,0,255,.6);display:flex;align-items:center;justify-content:center;overflow:hidden;transition:all .4s;box-shadow:0 0 40px rgba(255,0,255,.2),inset 0 0 30px rgba(255,0,255,.06)}
.airis.scanning{border-color:var(--a2);box-shadow:0 0 80px rgba(255,0,255,.6),inset 0 0 50px rgba(255,0,255,.15)}
.airis.verified{border-color:rgba(0,255,136,1);box-shadow:0 0 80px rgba(0,255,136,.7),inset 0 0 50px rgba(0,255,136,.15)}
.airis.denied{border-color:rgba(255,0,68,1);box-shadow:0 0 60px rgba(255,0,68,.5)}
.ae-pupil-w{width:48px;height:48px;border-radius:50%;background:#000;border:2px solid rgba(255,0,255,.7);box-shadow:0 0 16px rgba(255,0,255,.5);display:flex;align-items:center;justify-content:center;position:relative;z-index:2}
.ae-pupil{width:18px;height:18px;border-radius:50%;background:#000;box-shadow:0 0 8px rgba(255,0,255,.5)}
.ae-sh{position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,transparent,rgba(255,0,255,.95),transparent);animation:scanH 1.6s ease-in-out infinite}
.ae-sv{position:absolute;top:0;bottom:0;left:50%;width:2px;transform:translateX(-50%);background:linear-gradient(180deg,transparent,rgba(119,0,255,.8),transparent);animation:scanV 2s ease-in-out infinite .4s}
@keyframes scanV{0%,100%{height:0%;opacity:0}10%{opacity:1}90%{height:100%;opacity:1}}
.ae-iris-lines{position:absolute;inset:0;border-radius:50%;background:repeating-conic-gradient(rgba(255,0,255,.03) 0deg 5deg,transparent 5deg 10deg);animation:spin 10s linear infinite}
.ae-dots{position:absolute;inset:0;border-radius:50%}
.ae-stat{font-size:11px;color:var(--a2);letter-spacing:3px;font-weight:600;text-align:center;margin-bottom:4px;min-height:18px;transition:color .3s}
.ae-sub{font-size:8px;color:rgba(255,0,255,.3);letter-spacing:2px;text-align:center;margin-bottom:14px;min-height:14px}
.ae-bar{width:240px;height:2px;background:rgba(255,255,255,.05);border-radius:1px;overflow:hidden}
.ae-barf{height:100%;width:0%;background:linear-gradient(90deg,#ff00ff,#7700ff,#00ffff);transition:width .06s linear;border-radius:1px}
.ae-cancel{margin-top:16px;padding:6px 14px;background:none;border:1px solid rgba(255,255,255,.1);border-radius:7px;color:rgba(255,255,255,.3);font-size:8px;cursor:pointer}
.ae-hint{font-size:8px;color:rgba(255,0,255,.25);letter-spacing:1px;margin-top:10px;text-align:center}

/* ── APP ── */
#app{display:flex;height:100vh;opacity:0;transition:opacity .5s}
#app.on{opacity:1}
.sb{width:230px;background:var(--s1);border-right:1px solid var(--bdr);display:flex;flex-direction:column;padding:12px 8px;flex-shrink:0;overflow-y:auto}
.sbl{display:flex;align-items:center;gap:9px;padding:7px 7px 14px;border-bottom:1px solid var(--bdr);margin-bottom:9px}
.sbli{width:30px;height:30px;border-radius:7px;background:linear-gradient(135deg,var(--a),var(--a2));display:flex;align-items:center;justify-content:center;font-size:13px;flex-shrink:0}
.sblb{font-family:Orbitron,monospace;font-size:10px;font-weight:900;letter-spacing:2px;background:linear-gradient(90deg,var(--a),var(--a2));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.sblv{font-size:7px;color:var(--t3);letter-spacing:2px}
.sbn{width:100%;padding:8px;background:rgba(0,234,255,.06);border:1px solid rgba(0,234,255,.16);color:var(--a);border-radius:7px;cursor:pointer;font-size:10px;font-weight:600;display:flex;align-items:center;gap:7px;margin-bottom:9px;transition:all .2s;font-family:Inter,sans-serif}
.sbn:hover{background:rgba(0,234,255,.12)}
.sbs{font-size:7px;letter-spacing:2px;color:var(--t3);padding:0 6px;margin:5px 0 3px;text-transform:uppercase}
.sbb{width:100%;background:none;border:none;color:var(--t2);padding:7px;border-radius:7px;cursor:pointer;font-size:11px;font-family:Inter,sans-serif;text-align:left;display:flex;align-items:center;gap:7px;transition:all .15s;margin-bottom:1px}
.sbb:hover,.sbb.on{background:var(--s3);color:var(--txt)}
.ic{font-size:13px;width:16px;text-align:center;flex-shrink:0}
.sdiv{height:1px;background:var(--bdr);margin:5px 0}
.sfoot{margin-top:auto;padding-top:7px}
.susr{display:flex;align-items:center;gap:7px;padding:7px;border-radius:7px;background:var(--s2);border:1px solid var(--bdr);font-size:9px;color:var(--t2);margin-bottom:4px}
.sav{width:20px;height:20px;border-radius:50%;background:linear-gradient(135deg,var(--a),var(--a2));display:flex;align-items:center;justify-content:center;font-size:8px;color:#000;font-weight:700;flex-shrink:0}
.odot{width:6px;height:6px;border-radius:50%;background:var(--a3);animation:pulse 2s infinite;margin-left:auto}
@keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(0,255,136,.4)}50%{box-shadow:0 0 0 4px rgba(0,255,136,0)}}
.admbtn{width:100%;padding:8px;background:rgba(255,0,255,.06);border:1px solid rgba(255,0,255,.2);color:var(--a2);border-radius:7px;cursor:pointer;font-size:10px;font-weight:600;display:flex;align-items:center;gap:7px;transition:all .2s;font-family:Inter,sans-serif}
.admbtn:hover{background:rgba(255,0,255,.12)}
.mp{flex:1;display:flex;flex-direction:column;overflow:hidden;min-width:0}
.tb{padding:9px 14px;border-bottom:1px solid var(--bdr);display:flex;align-items:center;justify-content:space-between;background:var(--s1);flex-shrink:0;gap:8px}
.tbl,.tbr{display:flex;align-items:center;gap:5px}
.mbtn{width:30px;height:30px;background:none;border:1px solid var(--bdr);border-radius:6px;color:var(--t2);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:15px;transition:all .2s}
.mbtn:hover{border-color:rgba(0,234,255,.3);color:var(--txt)}
.ttl{font-family:Orbitron,monospace;font-size:11px;font-weight:700;letter-spacing:1px}
.mbadge{font-size:8px;padding:2px 7px;border-radius:10px;background:rgba(0,234,255,.08);color:var(--a);border:1px solid rgba(0,234,255,.18);letter-spacing:.8px}
.ppill{font-size:8px;padding:3px 9px;border-radius:10px;background:rgba(0,255,136,.07);color:var(--a3);border:1px solid rgba(0,255,136,.2);cursor:pointer;animation:tg 2s infinite}
@keyframes tg{0%,100%{box-shadow:none}50%{box-shadow:0 0 8px rgba(0,255,136,.3)}}
.mtabs{display:flex;gap:2px;padding:6px 12px;background:var(--s1);border-bottom:1px solid var(--bdr);overflow-x:auto;flex-shrink:0}
.mtabs::-webkit-scrollbar{height:0}
.mt{padding:4px 11px;border:1px solid var(--bdr);border-radius:13px;cursor:pointer;font-size:9px;color:var(--t2);background:none;font-family:Inter,sans-serif;transition:all .15s;white-space:nowrap}
.mt:hover{border-color:rgba(0,234,255,.3);color:var(--txt)}
.mt.on{background:var(--a);color:#000;border-color:var(--a);font-weight:600}
.chat{flex:1;overflow-y:auto;display:flex;flex-direction:column;scroll-behavior:smooth}
.wlc{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:24px 16px;text-align:center;animation:fi .5s ease}
@keyframes fi{from{opacity:0;transform:translateY(10px)}}
.worb{width:68px;height:68px;border-radius:50%;background:linear-gradient(135deg,var(--a),var(--a2),var(--a3));display:flex;align-items:center;justify-content:center;font-size:30px;margin:0 auto 14px;box-shadow:0 0 50px rgba(0,234,255,.2);animation:fl 3s ease-in-out infinite}
@keyframes fl{0%,100%{transform:translateY(0)}50%{transform:translateY(-7px)}}
.wtit{font-family:Orbitron,monospace;font-size:20px;font-weight:900;margin-bottom:5px;background:linear-gradient(135deg,#fff,#8899bb);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.wdesc{color:var(--t2);font-size:11px;max-width:420px;line-height:1.8;margin-bottom:14px}
.wchip{padding:8px 14px;background:rgba(0,255,136,.06);border:1px solid rgba(0,255,136,.2);border-radius:8px;margin-bottom:14px;font-size:9px;color:var(--a3);line-height:1.9}
.wbig{font-size:13px;font-weight:700;color:var(--a3);font-family:Orbitron,monospace;display:block;margin-bottom:2px}
.wg{display:grid;grid-template-columns:repeat(3,1fr);gap:5px;max-width:520px;width:100%}
@media(max-width:520px){.wg{grid-template-columns:repeat(2,1fr)}}
.wc{background:var(--s2);border:1px solid var(--bdr);border-radius:8px;padding:11px;cursor:pointer;text-align:left;transition:all .2s}
.wc:hover{border-color:var(--a);transform:translateY(-2px)}
.wci{font-size:17px;margin-bottom:4px}.wct{font-size:10px;font-weight:600;margin-bottom:2px}.wcd{font-size:8px;color:var(--t2)}
.mr{padding:12px 14px;animation:mi .22s ease;border-bottom:1px solid rgba(13,19,38,.8)}
@keyframes mi{from{opacity:0;transform:translateY(4px)}}
.mr.user{background:var(--bg)}.mr.ai{background:var(--s1)}
.mri{max-width:800px;margin:0 auto;display:flex;gap:9px;align-items:flex-start}
.mav{width:26px;height:26px;border-radius:7px;display:flex;align-items:center;justify-content:center;font-size:11px;flex-shrink:0;border:1px solid var(--bdr)}
.mr.user .mav{background:rgba(255,0,255,.1);border-color:rgba(255,0,255,.3)}
.mr.ai .mav{background:rgba(0,234,255,.08);border-color:rgba(0,234,255,.3)}
.mb{flex:1;min-width:0}
.mn{font-size:9px;font-weight:600;margin-bottom:4px;letter-spacing:.5px;display:flex;align-items:center;gap:5px;flex-wrap:wrap}
.mt2{font-size:13px;line-height:1.85;word-break:break-word}
.mt2 p{margin-bottom:7px}.mt2 p:last-child{margin-bottom:0}
.mt2 strong{color:#fff;font-weight:600}
.mt2 code{background:var(--s3);border:1px solid var(--bdr);padding:2px 5px;border-radius:4px;font-family:'Courier New',monospace;font-size:11px;color:#00eaff}
.mt2 pre{background:var(--s2);border:1px solid var(--bdr);border-radius:7px;padding:12px;margin:8px 0;overflow-x:auto}
.mt2 pre code{background:none;border:none;padding:0;color:#00ff88}
.mt2 h1{font-family:Orbitron,monospace;font-size:15px;color:var(--a);margin:10px 0 5px}
.mt2 h2{font-family:Orbitron,monospace;font-size:13px;color:var(--a2);margin:9px 0 4px}
.mt2 h3{font-family:Orbitron,monospace;font-size:11px;color:var(--a3);margin:7px 0 3px}
.mt2 ul,.mt2 ol{margin:5px 0 5px 16px}.mt2 li{margin-bottom:3px}
.mt2 blockquote{border-left:3px solid var(--a);padding:6px 11px;margin:7px 0;background:var(--s2);border-radius:0 5px 5px 0;color:var(--t2)}
.macts{display:flex;gap:4px;margin-top:7px;flex-wrap:wrap}
.mab{padding:3px 8px;border:1px solid var(--bdr);background:none;color:var(--t2);border-radius:5px;cursor:pointer;font-size:9px;font-family:Inter,sans-serif;transition:all .15s}
.mab:hover{border-color:rgba(0,234,255,.3);color:var(--txt)}
/* IMAGE */
.imgcard{background:var(--s2);border:1px solid var(--bdr);border-radius:11px;overflow:hidden;margin-top:7px}
.imgh{padding:7px 11px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--bdr)}
.imght{font-size:9px;font-weight:600;color:var(--a);letter-spacing:.5px}
.imgbody{position:relative;background:#000;min-height:60px}
.imgbody img{width:100%;max-height:400px;object-fit:cover;display:block;cursor:zoom-in}
.img2g{display:grid;grid-template-columns:1fr 1fr;gap:2px}
.img2g>div{position:relative;overflow:hidden;background:var(--s3);cursor:zoom-in}
.img2g img{width:100%;aspect-ratio:1;object-fit:cover;display:block;transition:transform .3s}
.img2g img:hover{transform:scale(1.03)}
.imgvb{position:absolute;bottom:4px;left:5px;font-size:7px;padding:2px 5px;background:rgba(0,0,0,.7);color:var(--a);border-radius:3px}
.imgacts{padding:7px 11px;display:flex;gap:5px;flex-wrap:wrap;border-top:1px solid var(--bdr)}
.iab{padding:4px 9px;border:1px solid var(--bdr);background:none;color:var(--t2);border-radius:5px;cursor:pointer;font-size:9px;font-family:Inter,sans-serif;transition:all .2s;text-decoration:none;display:inline-flex;align-items:center;gap:3px}
.iab:hover{border-color:var(--a);color:var(--a)}
.ipbar{width:180px;height:2px;background:rgba(255,255,255,.05);border-radius:1px;margin:10px auto 0;overflow:hidden}
.ipbarf{height:100%;width:0%;background:linear-gradient(90deg,var(--a),var(--a2),var(--a3));border-radius:1px;transition:width .4s ease}
/* VIDEO */
.vidcard{background:var(--s2);border:1px solid var(--bdr);border-radius:11px;overflow:hidden;margin-top:7px}
.vidh{padding:7px 11px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--bdr)}
.vidht{font-size:9px;font-weight:600;color:var(--a2);letter-spacing:.5px}
.vidwrap{position:relative;background:#000;overflow:hidden}
.vidwrap canvas{width:100%;display:block;max-height:320px}
.vidhud{position:absolute;inset:0;pointer-events:none;padding:9px}
.vhudt{display:flex;align-items:center;justify-content:space-between}
.vbadge{font-size:7px;padding:2px 7px;background:rgba(0,0,0,.65);border:1px solid rgba(0,234,255,.4);border-radius:4px;color:var(--a);letter-spacing:.5px}
.vrec{font-size:7px;padding:2px 7px;background:rgba(255,0,68,.15);border:1px solid rgba(255,0,68,.4);border-radius:4px;color:var(--a6);display:flex;align-items:center;gap:3px}
.rdot{width:4px;height:4px;border-radius:50%;background:var(--a6);animation:pulse 1s infinite}
.vhudb{position:absolute;bottom:8px;left:9px;right:9px;font-size:8px;color:rgba(255,255,255,.45);font-style:italic}
.vidctrl{padding:7px 11px;display:flex;gap:5px;align-items:center;flex-wrap:wrap;border-top:1px solid var(--bdr)}
.vb{padding:4px 9px;border:1px solid var(--bdr);background:none;color:var(--t2);border-radius:5px;cursor:pointer;font-size:9px;font-family:Inter,sans-serif;transition:all .2s}
.vb:hover{border-color:var(--a2);color:var(--a2)}
/* THINKING */
.tkr{padding:11px 14px}.tki{max-width:800px;margin:0 auto;display:flex;gap:9px;align-items:center}
.tds{display:flex;gap:4px}
.td{width:4px;height:4px;border-radius:50%;animation:tdot 1.3s ease-in-out infinite}
.td:nth-child(1){background:var(--a);animation-delay:0s}.td:nth-child(2){background:var(--a2);animation-delay:.2s}.td:nth-child(3){background:var(--a3);animation-delay:.4s}
@keyframes tdot{0%,100%{transform:scale(.5);opacity:.3}50%{transform:scale(1.2);opacity:1}}
.tl{font-size:8px;color:var(--t3);letter-spacing:1.5px;margin-left:5px}
/* ATTACH */
.atpv{display:flex;flex-wrap:wrap;gap:5px;padding:5px 12px;background:var(--s2);border-top:1px solid var(--bdr)}
.atch{display:flex;align-items:center;gap:5px;padding:4px 8px;background:var(--s3);border:1px solid var(--bdr);border-radius:7px;font-size:9px;color:var(--t2);max-width:180px}
.atch img{width:28px;height:28px;border-radius:4px;object-fit:cover;flex-shrink:0}
