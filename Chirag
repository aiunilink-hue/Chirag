function tgVoice(){isRec?stopVoice():startVoice();}
function startVoice(){const SR=window.SpeechRecognition||window.webkitSpeechRecognition;if(!SR){toast('❌ Use Chrome/Edge for voice');return;}const go=()=>{try{recog=new SR();recog.continuous=false;recog.interimResults=true;recog.lang=document.getElementById('lsel')?.value||'en-US';recog.onstart=()=>{isRec=true;const mb=document.getElementById('micbtn');if(mb){mb.classList.add('rec');mb.textContent='⏹';}document.getElementById('vbar')?.classList.add('on');const mi=document.getElementById('mi');if(mi)mi.placeholder='🎙 Listening...';};recog.onresult=e=>{let f='',int='';for(let i=e.resultIndex;i<e.results.length;i++){const t=e.results[i][0].transcript;e.results[i].isFinal?f+=t:int+=t;}const show=f||int;const mi=document.getElementById('mi');if(show&&mi){mi.value=show;aR(mi);}if(f){stopVoice();if(f.trim())sendMsg();}};recog.onerror=e=>{stopVoice();const m={'not-allowed':'🚫 Mic denied','no-speech':'🔇 No speech','audio-capture':'🎤 No mic'};toast(m[e.error]||'❌ Voice: '+e.error);};recog.onend=()=>{if(isRec)stopVoice();};recog.start();}catch(e){toast('❌ Voice: '+e.message);}};if(micOk){go();return;}navigator.mediaDevices?.getUserMedia({audio:true}).then(s=>{micOk=true;s.getTracks().forEach(t=>t.stop());go();}).catch(()=>toast('🚫 Mic denied — enable in Settings'));}
function stopVoice(){if(recog){try{recog.stop();}catch(e){}recog=null;}isRec=false;const mb=document.getElementById('micbtn');if(mb){mb.classList.remove('rec');mb.textContent='🎙';}document.getElementById('vbar')?.classList.remove('on');const mi=document.getElementById('mi');if(mi)mi.placeholder='Message NEURO AI...';}
function speakTxt(txt){if(!window.speechSynthesis||!ttsOn)return;window.speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(txt);u.lang=document.getElementById('lsel')?.value||'en-US';window.speechSynthesis.speak(u);}

// ═══ MESSAGES ═══
function addUserMsg(txt,files){rmWlc();const e=document.createElement('div');e.className='mr user';let fh='';if(files?.length)fh=`<div style="display:flex;flex-wrap:wrap;gap:5px;margin-bottom:7px">${files.map(f=>f.type.startsWith('image/')?`<img src="${f.data}" style="max-width:150px;max-height:130px;border-radius:7px;object-fit:cover;cursor:zoom-in" onclick="openImgFs('${escA(f.data)}')">`:`<div style="display:inline-flex;align-items:center;gap:5px;padding:4px 9px;background:var(--s3);border:1px solid var(--bdr);border-radius:7px;font-size:9px;color:var(--t2)">📄 ${escH(f.name)}</div>`).join('')}</div>`;e.innerHTML=`<div class="mri"><div class="mav">👤</div><div class="mb"><div class="mn">YOU</div>${fh}<div class="mt2">${escH(txt)}</div></div></div>`;cb().appendChild(e);scrollD();}
function addAiMsg(md){rmWlc();const e=document.createElement('div');e.className='mr ai';e.innerHTML=`<div class="mri"><div class="mav">✦</div><div class="mb"><div class="mn">NEURO AI <span style="font-size:7px;padding:1px 5px;border-radius:4px;background:rgba(0,234,255,.07);color:var(--a);border:1px solid rgba(0,234,255,.18)">v10</span></div><div class="mt2">${md2h(md)}</div><div class="macts"><button class="mab" onclick="cpMsg(this)">📋 Copy</button><button class="mab" onclick="rdMsg(this)">🔊 Read</button><button class="mab" onclick="if(lastMsg)sq(lastMsg)">🔄 Regen</button></div></div></div>`;cb().appendChild(e);scrollD();}
function addRawAiMsg(html){rmWlc();const e=document.createElement('div');e.className='mr ai';e.innerHTML=`<div class="mri"><div class="mav">✦</div><div class="mb"><div class="mn">NEURO AI <span style="font-size:7px;padding:1px 5px;border-radius:4px;background:rgba(0,234,255,.07);color:var(--a);border:1px solid rgba(0,234,255,.18)">v10</span></div>${html}</div></div>`;cb().appendChild(e);scrollD();}
function addErrMsg(t,m,orig){rmWlc();const e=document.createElement('div');e.className='mr ai';e.innerHTML=`<div class="mri"><div class="mav">✦</div><div class="mb"><div class="mn">NEURO AI</div><div style="background:rgba(255,0,68,.05);border:1px solid rgba(255,0,68,.2);border-radius:8px;padding:11px;margin-top:3px"><div style="font-size:11px;color:var(--a6);font-weight:600;margin-bottom:4px">⚠️ ${escH(t)}</div><div style="font-size:10px;color:var(--t2);line-height:1.7">${escH(m)}</div>${orig?`<button class="mab" style="margin-top:7px;border-color:rgba(0,234,255,.3);color:var(--a)" onclick="sq('${escA(orig)}')">🔄 Retry</button>`:''}</div></div></div>`;cb().appendChild(e);scrollD();}
let _tid=0;
function addThinking(){rmWlc();const id='tk_'+(++_tid);const e=document.createElement('div');e.className='tkr';e.id=id;e.innerHTML=`<div class="tki"><div class="mav" style="border-color:var(--a)">✦</div><div class="tds"><div class="td"></div><div class="td"></div><div class="td"></div></div><span class="tl">THINKING...</span></div>`;cb().appendChild(e);scrollD();return id;}
function removeThinking(id){document.getElementById(id)?.remove();}
function rmWlc(){document.getElementById('wlc')?.remove();}
function cb(){return document.getElementById('chatbox');}
function scrollD(){const c=cb();c.scrollTop=c.scrollHeight;}

// ═══ UTILS ═══
function newChat(){Object.keys(vidStates).forEach(id=>{cancelAnimationFrame(vidStates[id]?.raf);delete vidStates[id];});chatHist=[];lastMsg='';attachFiles=[];cb().innerHTML=`<div class="wlc" id="wlc"><div class="worb">✦</div><div class="wtit">NEURO AI v10</div><div class="wdesc">Ready for anything — chat, image, video, code, research...</div><div class="wchip"><span class="wbig">🎁 90-DAY TRIAL ACTIVE</span>All features unlocked · 🛡 Ultra Secure</div></div>`;renderAtpv();}
function exportChat(){const rows=document.querySelectorAll('.mr');let out='NEURO AI v10 Export\n'+'-'.repeat(40)+'\n'+new Date().toLocaleString()+'\n\n';rows.forEach(r=>{const role=r.classList.contains('user')?'YOU':'NEURO AI';const txt=r.querySelector('.mt2')?.innerText||'';if(txt)out+=`[${role}]\n${txt}\n\n`;});const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([out],{type:'text/plain'}));a.download='neuro-ai-v10-'+Date.now()+'.txt';a.click();toast('💾 Exported!');}
function cpMsg(btn){const txt=btn.closest('.mr').querySelector('.mt2')?.innerText||'';navigator.clipboard?.writeText(txt).then(()=>{btn.textContent='✅';setTimeout(()=>btn.textContent='📋 Copy',2e3);}).catch(()=>toast('❌ Copy failed'));}
function rdMsg(btn){if(!window.speechSynthesis)return;window.speechSynthesis.cancel();const txt=btn.closest('.mr').querySelector('.mt2')?.innerText?.slice(0,800)||'';const u=new SpeechSynthesisUtterance(txt);u.lang=document.getElementById('lsel')?.value||'en-US';u.onstart=()=>{btn.textContent='⏸ Stop';btn.onclick=()=>{window.speechSynthesis.cancel();btn.textContent='🔊 Read';btn.onclick=()=>rdMsg(btn);};};u.onend=u.onerror=()=>{btn.textContent='🔊 Read';btn.onclick=()=>rdMsg(btn);};window.speechSynthesis.speak(u);}
function sq(txt){document.getElementById('mi').value=txt;sendMsg();}
function toggleSb(){const sb=document.getElementById('sb');if(window.innerWidth<=720)sb.classList.toggle('open');else sb.classList.toggle('closed');}
function openMo(id){document.getElementById(id)?.classList.add('open');if(id==='upModal')renderPlans();}
function closeMo(id){document.getElementById(id)?.classList.remove('open');}
function closeAllMo(){document.querySelectorAll('.mo').forEach(m=>m.classList.remove('open'));}
function renderPlans(){const g=document.getElementById('plgrid');if(!g)return;const plans=[{n:'BASIC',p:300,i:'⚡',c:'var(--a3)',f:['50 chats/day','HD Images','Voice AI']},{n:'STANDARD',p:2000,i:'🌟',c:'#4499ff',f:['Unlimited Chat','Video AI','All Modes']},{n:'ADVANCE',p:10000,i:'🚀',c:'#aa44ff',pop:true,f:['Everything+','Admin','Priority']},{n:'PRO',p:25000,i:'👑',c:'#ffd700',f:['No Limits','Lifetime','Support']}];g.innerHTML=plans.map(p=>`<div class="plc${p.pop?' pop':''}" style="border-color:${p.c}33"><div style="font-size:22px;margin-bottom:5px">${p.i}</div><div style="font-family:Orbitron,monospace;font-size:9px;font-weight:700;color:${p.c};margin-bottom:3px">${p.n}</div><div style="font-size:17px;font-weight:700;color:${p.c}">₹${p.p.toLocaleString()}<span style="font-size:9px;color:var(--t2)">/mo</span></div><div style="font-size:8px;color:var(--t2);line-height:1.7;margin:7px 0">${p.f.map(f=>'✓ '+f).join('<br>')}</div><button style="width:100%;padding:6px;border:1px solid ${p.c};border-radius:6px;background:${p.c}15;color:${p.c};cursor:pointer;font-size:9px;font-weight:700" onclick="toast('🎁 Trial active — upgrade after 90 days!')">SELECT</button></div>`).join('');}
function onKey(e){if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();sendMsg();}}
function aR(el){el.style.height='auto';el.style.height=Math.min(el.scrollHeight,130)+'px';}
let _tt;function toast(m,d=3000){const t=document.getElementById('toast');if(!t)return;t.textContent=m;t.classList.add('on');clearTimeout(_tt);_tt=setTimeout(()=>t.classList.remove('on'),d);}
function escH(s){if(!s)return'';return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
function escA(s){return String(s||'').replace(/'/g,"\\'").replace(/"/g,'&quot;');}
function md2h(md){if(!md)return'';let h=escH(md);h=h.replace(/```(\w*)\n?([\s\S]*?)```/g,(_,l,c)=>`<pre><code>${c.trim()}</code></pre>`);h=h.replace(/`([^`]+)`/g,'<code>$1</code>');h=h.replace(/\*\*\*(.+?)\*\*\*/g,'<strong><em>$1</em></strong>');h=h.replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>');h=h.replace(/\*(.+?)\*/g,'<em>$1</em>');h=h.replace(/^#{3} (.+)$/gm,'<h3>$1</h3>');h=h.replace(/^#{2} (.+)$/gm,'<h2>$1</h2>');h=h.replace(/^# (.+)$/gm,'<h1>$1</h1>');h=h.replace(/^[•\-\*] (.+)$/gm,'<li>$1</li>');h=h.replace(/(<li>[\s\S]*?<\/li>\n?)+/g,m=>`<ul>${m}</ul>`);h=h.replace(/\n{2,}/g,'</p><p>');h=h.replace(/\n/g,'<br>');return'<p>'+h+'</p>';}
// CSS for spin animation (needed for loading spinners)
document.head.insertAdjacentHTML('beforeend','<style>@keyframes sp{to{transform:rotate(360deg)}}</style>');
// Note: keyboard events handled by security shield above
window.onerror=()=>true;window.addEventListener('unhandledrejection',e=>e.preventDefault());
</script>
